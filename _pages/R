# 4.1 Pearson相关性分析 + 显著性检验
# ====================================
library(Hmisc)
library(corrplot)

# 选择数值列
mydata_cor <- data[, c(列索引范围)]

# 计算相关性矩阵
cor_result <- rcorr(as.matrix(mydata_cor))
cor_matrix <- cor_result$r
p_matrix <- cor_result$P

# 可视化（带显著性标记）
testRes <- cor.mtest(mydata_cor, conf.level=0.95)
corrplot(cor_matrix, p.mat=testRes$p, method='circle', type='full',
         sig.level=c(0.001, 0.01, 0.05), 
         insig='label_sig', pch.col='grey20', diag=FALSE)

# 4.2 Mantel检验（环境因子 vs 物种/功能数据）
# ============================================
library(vegan)
library(ggcor)

# 执行Mantel检验
mantel_result <- mantel_test(物种数据, 环境数据,
                             spec.select = list(fCH4=1, fCO2=2, dCH4=3, dCO2=4)) %>%
  mutate(rd = cut(r, breaks=c(-Inf, 0.2, 0.4, Inf),
                  labels=c("< 0.2", "0.2 - 0.4", ">= 0.4")),
         pd = cut(p.value, breaks=c(-Inf, 0.01, 0.05, Inf),
                  labels=c("< 0.01", "0.01 - 0.05", ">= 0.05")))

# 配色方案
col_fun <- colorRampPalette(c("blue","white","red"))(50)

# 绘制组合图（相关性热图 + Mantel连线）
p_mantel <- quickcor(环境数据, type="upper", cor.test=TRUE) +
  geom_raster() +
  geom_mark(r=NA, sig.thres=0.05, size=4, colour="white") +
  scale_fill_gradientn(colours=col_fun) +
  anno_link(aes(colour=pd, size=rd), data=mantel_result) +
  scale_size_manual(values=c(0.5, 1, 1.2)) +
  scale_colour_manual(values=c("#D95F02", "#1B9E77", "#A2A2A288")) +
  guides(size=guide_legend(title="Mantel's r", override.aes=list(colour="grey35"), order=2),
         colour=guide_legend(title="Mantel's p", override.aes=list(size=3), order=1),
         fill=guide_colorbar(title="Pearson's r", order=3)) +
  theme(plot.margin=margin(b=1.5, unit="cm"))

ggsave("输出路径/mantel_combined.eps", plot=p_mantel, width=10, height=8, dpi=500)

# 4.3 RDA冗余分析
# ============================================
library(vegan)

# 判断使用RDA还是CCA（先运行DCA分析）
decorana(物种数据)  # 若Axis长度 < 3，使用RDA；否则使用CCA

# RDA分析
rda_result <- rda(物种数据 ~ ., 环境数据)
summary(rda_result)

# 提取各轴解释度
importance <- summary(rda_result)$concont$importance
rda_axis1 <- round(importance[2, 1] * 100, 2)
rda_axis2 <- round(importance[2, 2] * 100, 2)

# 提取绘图数据
pdat <- rda_result$CCA
samples <- data.frame(sample=row.names(pdat$u), RDA1=pdat$u[,1], RDA2=pdat$u[,2])
species <- data.frame(spece=row.names(pdat$v), RDA1=pdat$v[,1], RDA2=pdat$v[,2])
envi <- data.frame(en=row.names(pdat$biplot), RDA1=pdat$biplot[,1], RDA2=pdat$biplot[,2])

# 添加分组信息
samples$Zone <- as.factor(分组向量)

# 绘制RDA三序图
p_rda <- ggplot() +
  geom_hline(aes(yintercept=0), colour="gray88", linetype="dashed") +
  geom_vline(aes(xintercept=0), colour="gray88", linetype="dashed") +
  geom_point(data=species, aes(x=RDA1, y=RDA2), size=1, colour='pink', pch=3) +
  geom_segment(data=species, aes(x=0, xend=RDA1*0.8, y=0, yend=RDA2*0.8),
               arrow=arrow(length=unit(0.3,"cm")), colour='blue') +
  geom_text(data=species, aes(x=RDA1*1, y=RDA2*1, label=spece), size=3, colour='blue') +
  geom_segment(data=envi, aes(x=0, xend=RDA1*0.8, y=0, yend=RDA2*0.8),
               arrow=arrow(length=unit(0.3,"cm")), colour='red') +
  geom_text(data=envi, aes(x=RDA1*1, y=RDA2*1, label=en), size=3, colour='red', check_overlap=TRUE) +
  geom_point(data=samples, aes(x=RDA1, y=RDA2, colour=Zone), size=1) +
  theme_bw() +
  theme(panel.grid.major=element_line(colour=NA), panel.grid.minor=element_blank()) +
  xlab(paste('RDA1 (', rda_axis1, '%)', sep='')) +
  ylab(paste('RDA2 (', rda_axis2, '%)', sep=''))

ggsave("输出路径/RDA_plot.eps", plot=p_rda, width=10, height=8, dpi=500)

