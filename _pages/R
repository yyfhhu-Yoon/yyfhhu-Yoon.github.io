# 4.5 多元线性回归 + 逐步回归
# ============================================
library(car)
library(flextable)

# 全模型回归
lm_full <- lm(因变量 ~ ., data=数据)

# 检查多重共线性（VIF > 10 表示严重共线性）
vif_values <- vif(lm_full)
print(vif_values)

# 逐步回归（基于AIC准则）
lm_step <- step(lm_full, direction="both")

# 输出结果表格
as_flextable(lm_step)

# 4.6 PLS-PM结构方程模型
# ============================================
library(plspm)

# 定义路径矩阵（下三角矩阵，1表示影响关系）
# 示例：5个潜变量（DOM, Eutro, Env, CH4, CO2）
path_matrix <- rbind(
  DOM   = c(0, 0, 0, 0, 0),
  Eutro = c(1, 0, 0, 0, 0),
  Env   = c(1, 1, 0, 0, 0),
  CH4   = c(1, 1, 1, 0, 0),
  CO2   = c(1, 1, 1, 1, 0)
)

# 查看路径矩阵
innerplot(path_matrix)

# 定义测量模型（每个潜变量对应的观测变量列索引）
blocks_list <- list(1:3, 4:7, 8:10, 11:12, 13:14)

# 设置模型类型（均为反映型）
modes <- rep("A", 5)

# 执行PLSPM分析（含Bootstrap检验）
pls_result <- plspm(数据, path_matrix, blocks_list, 
                    modes=modes, boot.val=TRUE)

# 查看关键结果
summary(pls_result)
pls_result$gof  # 拟合优度（>0.7表示模型可靠）
pls_result$inner_model  # 路径系数和显著性

# 路径图可视化
innerplot(pls_result, colpos='#CA5023', colneg='#457CC3', 
          show.values=TRUE, lcol='gray20', box.lwd=0)

# 查看载荷值（需 > 0.7）
plot(pls_result, what="loadings", arr.width=0.1, 
     show.values=TRUE, lcol='gray')

